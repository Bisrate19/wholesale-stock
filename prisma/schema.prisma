generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  WINE
  BEER
  SOFT_DRINK
  SPIRIT
}

enum LocationType {
  WAREHOUSE
  SHOP
  VEHICLE
}

enum MovementType {
  RECEIVE
  TRANSFER
  DISPATCH
  ADJUSTMENT
}

model Product {
  id              String          @id @default(cuid())
  name            String          @unique
  category        ProductCategory
  bottlesPerCrate Int             @default(24)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  movements       StockMovement[]
  levels          StockLevel[]
}

model Location {
  id            String          @id @default(cuid())
  name          String          @unique
  type          LocationType
  active        Boolean         @default(true)
  movementsFrom StockMovement[] @relation("MovementFrom")
  movementsTo   StockMovement[] @relation("MovementTo")
  levels        StockLevel[]
}

model StockMovement {
  id             String       @id @default(cuid())
  type           MovementType
  quantity       Int
  note           String?
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  fromLocationId String?
  fromLocation   Location?    @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     Location?    @relation("MovementTo", fields: [toLocationId], references: [id])

  @@index([productId, occurredAt])
}

model StockLevel {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Int      @default(0)

  @@unique([productId, locationId])
}